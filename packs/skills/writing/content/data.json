{
  "name": "writing",
  "description": "论文写作体裁、章节骨架与提示词模板。合并自 paper_writing_assistant 的 writing/writer.py（其 DEFAULT_OUTLINE 硬编码 7 个中文小节），改为数据驱动：新增体裁或改语言只需改本文件。",
  "default_genre": "research_article",
  "genres": {
    "research_article": {
      "label": "研究论文",
      "language": "zh",
      "sections": [
        {
          "key": "abstract",
          "heading": "摘要",
          "words": 300
        },
        {
          "key": "introduction",
          "heading": "引言",
          "words": 1200
        },
        {
          "key": "methods",
          "heading": "方法",
          "words": 1500
        },
        {
          "key": "results",
          "heading": "结果",
          "words": 1200
        },
        {
          "key": "discussion",
          "heading": "讨论",
          "words": 1200
        },
        {
          "key": "conclusion",
          "heading": "结论",
          "words": 400
        },
        {
          "key": "references",
          "heading": "参考文献",
          "words": 0
        }
      ],
      "section_notes": {
        "introduction": "交代领域现状、已有工作缺口与本工作的定位，不堆砌文献。",
        "methods": "给出可复现的实验/计算流程，标注条件与来源。",
        "results": "只陈述有证据支持的观察，区分实测与推断。",
        "discussion": "解释机制、与既有工作的关系、局限性。"
      }
    },
    "frontier_review": {
