          "words": 600
        },
        {
          "key": "landscape",
          "heading": "研究版图与分类",
          "words": 1500
        },
        {
          "key": "mechanisms",
          "heading": "机制与设计原则",
          "words": 1800
        },
        {
          "key": "open_questions",
          "heading": "开放问题与机会缺口",
          "words": 1200
        },
        {
          "key": "outlook",
          "heading": "展望",
          "words": 600
        },
        {
          "key": "references",
          "heading": "参考文献",
