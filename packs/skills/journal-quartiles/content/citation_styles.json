{
  "name": "citation-styles",
  "description": "引用格式模板与期刊写法覆盖；与 quartiles/quartile_scores 共用 packs.normalize_journal_key() 作为期刊主键。合并自 paper_writing_assistant 的 library/citation.py，并补齐其三个缺陷（恒 @article、缺卷期页、中文 cite key）。",
  "default_style": "gb7714",
  "styles": {
    "gb7714": {
      "label": "GB/T 7714-2015",
      "kind": "plain",
      "journal_template": "{authors}. {title}[{doc_type}]. {venue}, {year}{volume_part}{pages_part}. DOI:{doi}.",
      "doc_type_default": "J",
      "doc_type_by_source_type": {
        "proceedings": "C",
        "book": "M",
        "book-chapter": "M",
        "repository": "EB/OL",
        "preprint": "EB/OL",
        "posted-content": "EB/OL",
        "dataset": "DS",
        "thesis": "D",
        "report": "R"
      },
      "missing": "无"
    },
    "apa": {
      "label": "APA 7th",
      "kind": "plain",
      "journal_template": "{authors} ({year}). {title}. {venue}{volume_part}{pages_part}. https://doi.org/{doi}",
      "doc_type_default": "",
      "doc_type_by_source_type": {},
      "missing": "n.d."
    },
    "acs": {
      "label": "ACS",
      "kind": "plain",
      "journal_template": "{authors} {year}. {title}. {venue_abbrev}{volume_part}{pages_part}. DOI: {doi}.",
      "doc_type_default": "",
      "doc_type_by_source_type": {},
      "missing": "n.d."
    },
    "bibtex": {
      "label": "BibTeX",
      "kind": "bibtex",
      "entry_type_default": "misc",
      "entry_type_by_source_type": {
        "journal": "article",
        "journal-article": "article",
        "proceedings": "inproceedings",
        "conference": "inproceedings",
        "book": "inbook",
        "book-chapter": "incollection",
        "repository": "misc",
        "preprint": "misc",
        "posted-content": "misc",
        "dataset": "misc",
        "thesis": "phdthesis",
        "report": "techreport"
      },
      "fields": ["author", "title", "journal", "year", "volume", "number", "pages", "doi", "url"],
      "venue_field_by_source_type": {
        "proceedings": "booktitle",
        "conference": "booktitle",
        "book": "booktitle",
        "book-chapter": "booktitle"
      },
      "missing": "n.d."
    },
    "ris": {
      "label": "RIS",
      "kind": "ris",
      "type_by_source_type": {
        "journal": "JOUR",
        "journal-article": "JOUR",
        "proceedings": "CONF",
        "conference": "CONF",
        "book": "BOOK",
        "book-chapter": "CHAP",
        "repository": "ELEC",
        "preprint": "ELEC",
        "posted-content": "ELEC",
        "dataset": "DATA",
        "thesis": "THES",
        "report": "RPRT"
      },
      "type_default": "GEN",
      "missing": ""
    },
    "markdown": {
      "label": "Markdown 清单",
      "kind": "markdown",
      "missing": "—"
    }
  },
  "venue_overrides": {
    "angewandte chemie international edition": {
      "abbrev": "Angew. Chem. Int. Ed.",
